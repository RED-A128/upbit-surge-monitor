# ============================================================
# 30. Historical Gap Recovery Repair runtime data
# ============================================================
#
# Generated by:
#
#   recover_history_gaps.py - Clean V003
#   recover_history_gaps_repair.yml
#
# data/recovery/ is already ignored globally above.
#
# Explicit validation/runtime entries are kept here so the
# project safety policy remains visible in this file.
#
# ============================================================

data/validation/recover_history_gaps_checkpoint.json
data/validation/recover_history_gaps_ohlcv_before.sha256.json
data/validation/recover_history_gaps_ohlcv_after.sha256.json

# Repair status is versioned by recover_history_gaps.py.
# Ignore all generated repair-status versions.
data/recover_history_gaps_repair_status_v*.csv


# ============================================================
# 31. Post-Recovery Gap Audit runtime data
# ============================================================
#
# Generated by:
#
#   post_recovery_gap_audit.yml
#
# Purpose:
#
#   - Re-run gap reporting after actual historical recovery
#   - Compare pre-recovery and post-recovery gap state
#   - Verify recovery effectiveness
#   - Verify source OHLCV safety during audit
#
# These files are runtime validation/report outputs.
#
# ============================================================

data/reports/post_recovery_gap/
data/reports/post_recovery_gap_audit/

data/validation/post_recovery_gap_audit_checkpoint.json
data/post_recovery_gap_audit_status.csv

data/validation/post_recovery_ohlcv_before.sha256.json
data/validation/post_recovery_ohlcv_after.sha256.json

# Final audit result generated at runtime.
data/post_recovery_gap_audit_result.json

# Temporary/source snapshots generated by the audit workflow.
data/validation/post_recovery_audit_ohlcv_before.csv
data/validation/post_recovery_gap_source_before.csv


# ============================================================
# 32. Post-Recovery Gap Analysis runtime data
# ============================================================
#
# Generated by:
#
#   analyze_post_recovery_gaps.py
#   analyze_post_recovery_gaps_test.yml
#
# Purpose:
#
#   - Analyze pre-recovery vs post-recovery gap results
#   - Calculate recovered gap counts
#   - Calculate remaining gap counts
#   - Classify remaining recovery candidates
#   - Generate second-pass recovery targets
#   - Persist analysis checkpoint/status
#
# IMPORTANT
#
# This analysis stage is READ ONLY with respect to OHLCV.
#
# It must NOT:
#
#   - modify OHLCV
#   - delete OHLCV
#   - repair gaps
#   - download candles
#   - build features
#   - run prediction
#   - trade
#
# All generated analysis outputs are runtime data and must
# remain outside Git tracking.
#
# ============================================================

data/reports/post_recovery_analysis/

data/recovery/history_gap_second_pass_targets.csv

data/validation/analyze_post_recovery_gaps_checkpoint.json
data/analyze_post_recovery_gaps_status.csv

data/validation/analyze_post_recovery_ohlcv_before.sha256.json
data/validation/analyze_post_recovery_ohlcv_after.sha256.json


# ============================================================
# 33. Runtime SHA256 / validation safety artifacts
# ============================================================
#
# SHA256 snapshots are generated only to verify that source
# OHLCV or other protected inputs were not unexpectedly changed.
#
# These are runtime safety artifacts, not source files.
#
# Do NOT use a broad rule such as:
#
#   data/validation/*
#
# because future validation source/reference files may need
# to remain Git-tracked.
#
# Keep explicit patterns instead.
#
# ============================================================

data/validation/*_ohlcv_before.sha256.json
data/validation/*_ohlcv_after.sha256.json


# ============================================================
# 34. IMPORTANT PROJECT SAFETY NOTES
# ============================================================
#
# DO NOT add broad rules such as:
#
#   data/
#   data/validation/
#   *.csv
#   *.json
#
# Those rules are intentionally forbidden here because they
# could hide source/reference/configuration files that should
# remain visible to Git.
#
# Runtime outputs should always be ignored using explicit
# directories or explicit filenames/patterns.
#
# ============================================================


# ============================================================
# END
# ============================================================
