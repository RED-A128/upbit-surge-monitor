# ============================================================

data/reports/history_gap/
data/validation/data_history_gap_report_checkpoint.json
data/data_history_gap_report_status.csv

data/validation/gap_report_ohlcv_*.sha256


# ============================================================
# 25. Historical Gap Recovery runtime data
# ============================================================
#
# recover_history_gaps.py
#
# Includes:
#   - persistent checkpoint
#   - recovery status
#   - recovery reports
#   - temporary recovery state
#
# These files are runtime state and must stay local.
#
# ============================================================

data/recovery/
data/recover_history_gaps_status.csv


# ============================================================
# 26. History Gap Classifier runtime data
# ============================================================

data/reports/history_gap_classification/
data/validation/classify_history_gaps_checkpoint.json


# ============================================================
# 27. History Gap Classifier test runtime files
# ============================================================

data/validation/classifier_gap_report_before.sha256
data/validation/classifier_gap_summary_before.sha256
data/validation/classifier_ohlcv_before.sha256


# ============================================================
# 28. History Gap Classification Review runtime data
# ============================================================
#
# review_history_gap_classification.py
#
# These files classify recovery targets and preserve review
# checkpoint/status information.
#
# ============================================================

data/recovery/history_gap_recovery_targets.csv
data/recovery/history_gap_recovery_plan.json

data/reports/history_gap_classification_review_summary.csv
data/reports/history_gap_classification_review_detail.csv
data/reports/history_gap_structural.csv
data/reports/history_gap_manual_review.csv

data/validation/review_history_gap_classification_checkpoint.json
data/review_history_gap_classification_status.csv


# ============================================================
# 29. History Gap Classification Review test hashes
# ============================================================

data/validation/review_classifier_source_before.sha256
data/validation/review_ohlcv_before.sha256.json


# ============================================================
# 30. Historical Gap Actual Repair runtime data
# ============================================================
#
# recover_history_gaps.py - Clean V003 actual repair mode
#
# IMPORTANT:
#
# The repaired OHLCV source itself is already protected by:
#
#   data/ohlcv/
#
# Recovery checkpoint/report/status files are protected by:
#
#   data/recovery/
#
# This explicit rule is retained for compatibility with the
# current recovery status output.
#
# ============================================================

data/recover_history_gaps_status.csv


# ============================================================
# 31. Post-Recovery Gap Audit runtime data
# ============================================================
#
# post_recovery_gap_audit.yml
#
# After actual historical recovery, the audit stage re-runs
# history verification and records post-recovery results.
#
# These files are generated verification/runtime outputs and
# must NOT become Git source changes.
#
# ============================================================

data/post_recovery_gap_audit_result.json
data/post_recovery_gap_audit_status.csv

data/reports/post_recovery_gap_audit/
data/validation/post_recovery_gap_audit_checkpoint.json

data/validation/post_recovery_ohlcv.sha256
data/validation/post_recovery_gap_report.sha256


# ============================================================
# 32. Post-Recovery temporary verification files
# ============================================================
#
# GitHub Actions safety checks may create temporary before/after
# SHA256 snapshots. Ignore all files using the dedicated
# post-recovery validation prefix.
#
# ============================================================

data/validation/post_recovery_*.sha256
data/validation/post_recovery_*.sha256.json


# ============================================================
# 33. Keep directory placeholders when required
# ============================================================
#
# A directory can contain a .gitkeep file if Git needs to
# preserve an otherwise empty directory.
#
# Example:
#
#   data/ohlcv/.gitkeep
#
# ============================================================

!**/.gitkeep


# ============================================================
# END
# ============================================================
