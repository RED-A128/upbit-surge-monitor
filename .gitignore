# ============================================================
# 34. History Gap Retry Planner runtime data
#     Clean V001
# ============================================================
#
# Generated by:
#
#   plan_history_gap_retry.py - Clean V001
#   plan_history_gap_retry_test.yml - Clean V001
#
#
# PURPOSE
#
#   - Read recovery-audit retry candidates
#   - Re-check remaining gaps against current OHLCV
#   - Classify second-pass eligibility
#   - Generate READY_SECOND_PASS targets
#   - Persist planner reports/checkpoint/status
#
#
# IMPORTANT
#
#   This stage is READ ONLY with respect to OHLCV.
#
#   It must NOT:
#
#   - modify OHLCV
#   - delete OHLCV
#   - download candles
#   - execute recovery
#   - build features
#   - run detectors
#   - predict
#   - trade
#
#
# NOTE
#
#   data/recovery/ is already ignored globally.
#
#   Explicit recovery files are listed here as documentation
#   of the planner's exact runtime outputs.
#
# ============================================================

data/recovery/history_gap_second_pass_targets.csv
data/recovery/history_gap_second_pass_plan.json

data/reports/history_gap_retry_plan/

data/validation/plan_history_gap_retry_checkpoint.json

data/plan_history_gap_retry_status.csv

data/validation/plan_history_gap_retry_ohlcv_before.sha256
data/validation/plan_history_gap_retry_ohlcv_after.sha256

data/validation/plan_history_gap_retry_ohlcv_before.sha256.json
data/validation/plan_history_gap_retry_ohlcv_after.sha256.json


# ============================================================
# 35. Runtime SHA256 / validation safety artifacts
# ============================================================
#
# SHA256 snapshots are generated only to verify that source
# OHLCV or other protected inputs were not unexpectedly changed.
#
# These are runtime safety artifacts, not source files.
#
#
# IMPORTANT
#
# Do NOT replace these explicit patterns with:
#
#   data/validation/
#
# The validation directory may later contain source/reference
# files that should remain visible to Git.
#
# ============================================================

data/validation/*_ohlcv_before.sha256.json
data/validation/*_ohlcv_after.sha256.json

data/validation/*_ohlcv_before.sha256
data/validation/*_ohlcv_after.sha256


# ============================================================
# 36. IMPORTANT PROJECT SAFETY NOTES
# ============================================================
#
# DO NOT add broad rules such as:
#
#   data/
#   data/validation/
#   *.csv
#   *.json
#
# Those rules are intentionally forbidden because they could
# hide source/reference/configuration files that should remain
# visible to Git.
#
#
# Runtime outputs must be ignored using:
#
#   - explicit runtime directories
#   - explicit filenames
#   - narrowly scoped runtime patterns
#
#
# SOURCE CODE MUST REMAIN TRACKED
#
# Examples:
#
#   collector.py
#   backfill_history.py
#   build_features.py
#   detect_256.py
#   validate_256.py
#   recover_history_gaps.py
#   analyze_post_recovery_gaps.py
#   audit_history_gap_recovery.py
#   plan_history_gap_retry.py
#
# and:
#
#   .github/workflows/*.yml
#
# must remain visible to Git.
#
# ============================================================


# ============================================================
# END
# ============================================================
