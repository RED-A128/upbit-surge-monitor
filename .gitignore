# ============================================================
# 24. Historical Gap Recovery runtime data
# ============================================================
#
# IMPORTANT:
#
# data/recovery/ contains runtime recovery state such as:
#
#   history_gap_recovery_targets.csv
#   history_gap_recovery_plan.json
#
#   checkpoint/
#     recover_history_gaps_checkpoint.json
#     recover_history_gaps_repair_checkpoint_v003.json
#
#   reports/
#     historical_gap_repair_detail_v003.csv
#     historical_gap_repair_summary_v003.csv
#     historical_gap_repair_meta_v003.json
#
# These files are local runtime state.
#
# The checkpoint MUST remain on the self-hosted runner so that
# interrupted recovery can resume instead of restarting.
#
# DO NOT remove this rule while historical recovery is active.
#
# ============================================================

data/recovery/


# ============================================================
# 25. Historical Gap Recovery status files
# ============================================================
#
# Legacy / Preview status:
#
#   data/recover_history_gaps_status.csv
#
# Clean V003 actual repair status:
#
#   data/recover_history_gaps_repair_status_v003.csv
#
# ============================================================

data/recover_history_gaps_status.csv
data/recover_history_gaps_repair_status_v003.csv


