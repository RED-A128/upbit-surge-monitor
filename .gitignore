actions-runner/
_runner/
_work/
_diag/


# ============================================================
# 13. Upbit Surge Monitor - OHLCV raw data
# ============================================================
#
# IMPORTANT
#
# Raw OHLCV data can become very large.
#
# Current project stores:
#
#   data/ohlcv/h1/
#   data/ohlcv/h4/
#   data/ohlcv/d1/
#
# These files are accumulated locally and must NOT be committed
# to the Git repository.
#
# Collector / Backfill / Recovery source code remains tracked.
#
# ============================================================

data/ohlcv/


# ============================================================
# 14. Collector runtime status
# ============================================================
#
# Generated by collector.py during execution.
#
# Runtime output, not source code.
#
# ============================================================

data/collector_status.csv
data/collector_status_clean_v002.csv
data/collector/


# ============================================================
# 15. Backfill runtime status
# ============================================================
#
# Generated by backfill_history.py during execution.
#
# Records local historical backfill progress/status.
#
# Runtime output, not source code.
#
# ============================================================

data/backfill_status.csv


# ============================================================
# 16. Feature runtime data
# ============================================================
#
# Feature snapshots can become very large as the project grows.
#
# build_features.py generates:
#
#   data/features/
#   data/latest_features.csv
#   data/feature_build_status.csv
#
# These are generated runtime outputs and must NOT be committed.
#
# build_features.py source code remains tracked.
#
# ============================================================

data/features/
data/latest_features.csv
data/feature_build_status.csv


# ============================================================
# 17. Future generated datasets
# ============================================================

data/datasets/
data/training/
data/backtest/
data/cache/


# ============================================================
# 18. Future model artifacts
# ============================================================

models/

*.joblib
*.pkl
*.pickle
*.model
*.bin


# ============================================================
# 19. Generated reports
# ============================================================
#
# NOTE
#
# Generic root-level reports are ignored here.
#
# Project-specific reports under data/reports/ are handled
# separately below.
#
# ============================================================

reports/


# ============================================================
# 20. Local output files
# ============================================================

output/
outputs/


# ============================================================
# 21. Keep directory placeholders when required
# ============================================================
#
# A directory can contain a .gitkeep file if Git needs to
# preserve an otherwise empty directory.
#
# Example:
#
#   data/ohlcv/.gitkeep
#
# ============================================================

!**/.gitkeep


