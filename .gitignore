# ============================================================
# 27. History Gap Recovery Audit - Clean V001 runtime data
# ============================================================
#
# audit_history_gap_recovery.py generates:
#
#   data/reports/history_gap_recovery_audit/
#       history_gap_recovery_audit_summary.csv
#       history_gap_recovery_audit_detail.csv
#       history_gap_recovery_audit_result.json
#
#   data/recovery/
#       history_gap_recovery_retry_candidates.csv
#
#   data/validation/
#       audit_history_gap_recovery_checkpoint.json
#
# audit_history_gap_recovery_test.yml additionally generates:
#
#       audit_history_gap_recovery_ohlcv_before.sha256
#       audit_history_gap_recovery_ohlcv_after.sha256
#
# All files below are generated runtime/audit outputs.
# They must NOT be committed to the Git repository.
#
# IMPORTANT:
#
# audit_history_gap_recovery.py source code remains tracked.
#
# .github/workflows/audit_history_gap_recovery_test.yml
# remains tracked.
#
# ============================================================

data/reports/history_gap_recovery_audit/

data/recovery/history_gap_recovery_retry_candidates.csv

data/validation/audit_history_gap_recovery_checkpoint.json

data/validation/audit_history_gap_recovery_ohlcv_before.sha256
data/validation/audit_history_gap_recovery_ohlcv_after.sha256


